# Copia este archivo como backend/.env y completa los valores.
# Las variables sin valor por defecto son OBLIGATORIAS: sin ellas la API no arranca.

# --- Entorno: development | production ---
APP_ENV=development

# --- Base de datos (OBLIGATORIO) ---
MONGO_URI=mongodb+srv://usuario:clave@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=kawari

# --- Seguridad (OBLIGATORIO, mínimo 32 caracteres aleatorios) ---
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# En producción la cookie de sesión es Secure automáticamente. SameSite=lax exige que el frontend
# y la API compartan sitio (p. ej. kawari.com y api.kawari.com).
REFRESH_COOKIE_SAMESITE=lax
# Lista JSON de orígenes del frontend permitidos
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
FRONTEND_URL=http://localhost:5173

# --- Hotel ---
HOTEL_NAME=Hotel Kawari
TIMEZONE=America/Bogota
CURRENCY=COP
DEPOSIT_PERCENT=50
BOOKING_PAYMENT_DEADLINE_HOURS=48
BOOKING_EXPIRATION_CHECK_MINUTES=15
BOOKING_CODE_PREFIX=KW

# --- Archivos ---
# PRIVATE_UPLOAD_DIR=/ruta/fuera/de/static   (comprobantes de pago; nunca servida públicamente)
MAX_IMAGE_SIZE_MB=8
MAX_RECEIPT_SIZE_MB=5

# --- Correo: console (desarrollo, se muestra en el log) | smtp ---
EMAIL_BACKEND=console
EMAIL_FROM=Hotel Kawari <reservas@kawari.com>
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
# SMTP_SSL=false

# --- Tareas programadas (desactivar en réplicas adicionales) ---
SCHEDULER_ENABLED=true

# --- Seed (python -m backend.scripts.seed) ---
SEED_ADMIN_EMAIL=admin@kawari.com
# SEED_ADMIN_PASSWORD=   (si se omite, se genera una y se muestra una sola vez)
SEED_ADMIN_NAME=Administrador
